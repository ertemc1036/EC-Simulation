# OpenAI-compatible LLM API (required for mode=llm; never commit real keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Live-test ceilings (code clamps: agents≤5, rounds≤2, calls≤10, retries=0)
# 5 agents × 2 rounds ≤ 10 model calls. LLM start also requires llm_run_approved=true.
# Per LLM round: 1 model call per agent (OASIS perform_action_by_llm → astep).
# Phase 6: Offline/Scripted may use 10/25/50 agents — does NOT unlock paid Live-LLM.
MAX_SIMULATION_STEPS=2
MAX_LLM_CALLS_PER_RUN=10
MAX_TOKENS_PER_CALL=500
MAX_TOKENS_PER_RUN=20000
MAX_COST_USD_PER_RUN=0.20
# Serialize in-round LLM calls (OASIS semaphore). Ceiling 1 — do not raise.
MAX_PARALLEL_LLM_CALLS=1
LLM_MAX_RETRIES=0
AGENT_MEMORY_WINDOW=6
AGENT_LOCAL_MEMORY_ENTRIES=12
DEFAULT_AGENT_COUNT=5
# dynamic = scenario-derived unique personas; fixed_test = classic Alice…Eve roster
# Offline society scale (manual/scripted): presets 10/25/50 via API agent_count.
AGENT_GENERATION_MODE=dynamic
REQUEST_TIMEOUT_SECONDS=60
ALLOW_LLM_MODE=true

# Simulation content language (default German — overrides OASIS English system prompts)
SIMULATION_LANGUAGE=de

# USD / 1M tokens — dashboard estimate + hard cost gate (gpt-4.1-mini list prices)
LLM_PRICE_INPUT_PER_1M=0.40
LLM_PRICE_OUTPUT_PER_1M=1.60

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Zep memory (Vorbereitung only — NOT integrated; local memory is active)
ZEP_ENABLED=false
ZEP_API_KEY=
ZEP_API_URL=https://api.getzep.com
ZEP_PROJECT_NAME=ec-simulation

# Paths
RESULTS_DIR=data/results
