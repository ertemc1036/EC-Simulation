# OpenAI-compatible LLM API (optional for Phase 1 ManualAction mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cost / safety limits
MAX_SIMULATION_STEPS=8
MAX_LLM_CALLS_PER_RUN=40
MAX_TOKENS_PER_CALL=512
REQUEST_TIMEOUT_SECONDS=60
ALLOW_LLM_MODE=true

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Zep memory (optional stub — no calls unless ZEP_ENABLED=true and key set)
ZEP_ENABLED=false
ZEP_API_KEY=
ZEP_API_URL=https://api.getzep.com
ZEP_PROJECT_NAME=ec-simulation

# Paths
RESULTS_DIR=data/results
