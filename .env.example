# OpenAI-compatible LLM API (required for mode=llm; never commit real keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# First LLMAction readiness budget: 5 agents × 2 rounds ≤ 10 calls
MAX_SIMULATION_STEPS=2
MAX_LLM_CALLS_PER_RUN=10
MAX_TOKENS_PER_CALL=500
MAX_TOKENS_PER_RUN=20000
MAX_COST_USD_PER_RUN=0.20
LLM_MAX_RETRIES=0
AGENT_MEMORY_WINDOW=6
REQUEST_TIMEOUT_SECONDS=60
ALLOW_LLM_MODE=true

# USD / 1M tokens — dashboard estimate + hard cost gate (gpt-4.1-mini list prices)
LLM_PRICE_INPUT_PER_1M=0.40
LLM_PRICE_OUTPUT_PER_1M=1.60

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Zep memory (optional stub — no calls unless ZEP_ENABLED=true and key set)
ZEP_ENABLED=false
ZEP_API_KEY=
ZEP_API_URL=https://api.getzep.com
ZEP_PROJECT_NAME=ec-simulation

# Paths
RESULTS_DIR=data/results
